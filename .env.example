# Copiar a .env (no se sube al repo): cp .env.example .env

# --- Mail (Gmail) ---
# Activá la verificación en 2 pasos y generá una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords. NO uses tu contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_TO=tu_cuenta@gmail.com

# --- WhatsApp (opcional, vía CallMeBot) ---
# Ver README -> "Aviso por WhatsApp". Vacío = no manda WhatsApp.
# Argentina: +549 + código de área + número, sin el 15 (ej. +5491123456789).
WHATSAPP_TELEFONO=
WHATSAPP_APIKEY=
# resumen (por defecto: solo cuántas novedades hay) | completo (incluye notas y materias)
WHATSAPP_DETALLE=resumen

# --- SIU ---
# Propuesta a elegir en el selector de arriba a la derecha, tal como aparece en el SIU.
# Dejalo vacío si tenés una sola carrera.
SIU_CARRERA=Ingeniería en informática

# Horas en las que no revisa (desde-hasta, formato 24 h; admite cruzar medianoche, ej. 23-7).
# Vacío = revisa siempre.
SIU_SILENCIO=0-7

# (Opcional) Navegador para Playwright: msedge, chrome... Por defecto, el de tu sistema.
# SIU_NAVEGADOR=msedge

# Diseño del mail: siu (formal, por defecto) o futurista
MAIL_TEMA=siu
